{
  "name": "CLM Propostas Escuro",
  "dataColors": ["#3987E5", "#D95926", "#199E70", "#C98500", "#D55181", "#008300", "#9085E9", "#E66767"],
  "background": "#151C26",
  "backgroundLight": "#1B232F",
  "backgroundNeutral": "#27303D",
  "foreground": "#F2F5F9",
  "foregroundNeutralSecondary": "#9DAABD",
  "foregroundNeutralTertiary": "#7A8798",
  "tableAccent": "#3987E5",
  "good": "#0CA30C",
  "neutral": "#FAB219",
  "bad": "#D03B3B",
  "maximum": "#9EC5F4",
  "minimum": "#184F95",
  "textClasses": {
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 14, "color": "#F2F5F9" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#9DAABD" },
    "callout": { "fontFace": "Segoe UI Bold", "fontSize": 32, "color": "#F2F5F9" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#151C26" } } }],
        "border": [{ "show": true, "color": { "solid": { "color": "#27303D" } }, "radius": 10 }],
        "dropShadow": [{ "show": false }],
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#F2F5F9" } }, "fontFamily": "Segoe UI Semibold", "fontSize": 12, "alignment": "left" }],
        "padding": [{ "top": 12, "bottom": 12, "left": 14, "right": 14 }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#0C1116" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#0C1116" } }, "transparency": 0 }]
      }
    },
    "card": {
      "*": {
        "labels": [{ "color": { "solid": { "color": "#F2F5F9" } }, "fontFamily": "Segoe UI Bold", "fontSize": 30 }],
        "categoryLabels": [{ "show": true, "color": { "solid": { "color": "#9DAABD" } }, "fontFamily": "Segoe UI Semibold", "fontSize": 9 }]
      }
    },
    "multiRowCard": {
      "*": {
        "dataLabels": [{ "color": { "solid": { "color": "#F2F5F9" } }, "fontFamily": "Segoe UI Bold", "fontSize": 22 }],
        "categoryLabels": [{ "color": { "solid": { "color": "#9DAABD" } }, "fontSize": 9 }],
        "cardTitle": [{ "color": { "solid": { "color": "#F2F5F9" } }, "fontSize": 11 }]
      }
    },
    "tableEx": {
      "*": {
        "grid": [{ "gridVertical": false, "gridHorizontal": true, "gridHorizontalColor": { "solid": { "color": "#1F2833" } }, "rowPadding": 8, "outlineColor": { "solid": { "color": "#27303D" } } }],
        "columnHeaders": [{ "fontColor": { "solid": { "color": "#9DAABD" } }, "backColor": { "solid": { "color": "#1B232F" } }, "fontFamily": "Segoe UI Semibold", "fontSize": 9 }],
        "values": [{ "fontColor": { "solid": { "color": "#F2F5F9" } }, "backColor": { "solid": { "color": "#151C26" } }, "fontSize": 11 }]
      }
    },
    "slicer": {
      "*": {
        "header": [{ "show": true, "fontColor": { "solid": { "color": "#9DAABD" } }, "fontFamily": "Segoe UI Semibold", "fontSize": 9, "outline": "None" }],
        "items": [{ "fontColor": { "solid": { "color": "#F2F5F9" } }, "background": { "solid": { "color": "#1B232F" } }, "fontSize": 11 }]
      }
    },
    "barChart": {
      "*": {
        "categoryAxis": [{ "showAxisTitle": false, "labelColor": { "solid": { "color": "#9DAABD" } }, "gridlineShow": false }],
        "valueAxis": [{ "showAxisTitle": false, "labelColor": { "solid": { "color": "#7A8798" } }, "gridlineColor": { "solid": { "color": "#1F2833" } } }],
        "legend": [{ "show": true, "position": "Top", "showTitle": false, "labelColor": { "solid": { "color": "#9DAABD" } } }]
      }
    },
    "textbox": {
      "*": {
        "background": [{ "show": false }],
        "border": [{ "show": false }],
        "dropShadow": [{ "show": false }]
      }
    },
    "actionButton": {
      "*": {
        "fill": [{ "show": true, "fillColor": { "solid": { "color": "#1B232F" } }, "transparency": 0 }],
        "text": [{ "show": true, "fontColor": { "solid": { "color": "#F2F5F9" } }, "fontFamily": "Segoe UI Semibold", "fontSize": 11 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#27303D" } }, "radius": 8 }],
        "dropShadow": [{ "show": false }]
      }
    }
  }
}
