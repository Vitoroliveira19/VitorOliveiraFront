{
  "name": "Pricing Propostas",
  "dataColors": [
    "#2a78d6",
    "#eb6834",
    "#1baf7a",
    "#eda100",
    "#e87ba4",
    "#008300",
    "#4a3aa7",
    "#e34948"
  ],
  "background": "#FFFFFF",
  "backgroundLight": "#F6F8FB",
  "backgroundNeutral": "#DDE3EC",
  "foreground": "#101A29",
  "foregroundNeutralSecondary": "#5A6A80",
  "foregroundNeutralTertiary": "#8996A8",
  "tableAccent": "#2A78D6",
  "good": "#0CA30C",
  "neutral": "#FAB219",
  "bad": "#D03B3B",
  "maximum": "#184F95",
  "center": "#9EC5F4",
  "minimum": "#CDE2FB",
  "textClasses": {
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 15, "color": "#101A29" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#101A29" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#5A6A80" },
    "callout": { "fontFace": "Segoe UI Bold", "fontSize": 34, "color": "#101A29" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#DDE3EC" } }, "radius": 10 }],
        "dropShadow": [{ "show": true, "color": { "solid": { "color": "#101A29" } }, "position": "Outer", "preset": "BottomRight", "shadowSpread": 4, "shadowBlur": 12, "transparency": 90 }],
        "visualHeader": [{ "show": true, "transparency": 100, "foreground": { "solid": { "color": "#8996A8" } } }],
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#101A29" } }, "fontFamily": "Segoe UI Semibold", "fontSize": 12, "alignment": "left" }],
        "subTitle": [{ "show": true, "fontColor": { "solid": { "color": "#5A6A80" } }, "fontFamily": "Segoe UI", "fontSize": 9 }],
        "padding": [{ "top": 14, "bottom": 12, "left": 16, "right": 16 }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#EEF1F6" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#EEF1F6" } }, "transparency": 0 }]
      }
    },
    "card": {
      "*": {
        "labels": [{ "color": { "solid": { "color": "#101A29" } }, "fontFamily": "Segoe UI Bold", "fontSize": 32 }],
        "categoryLabels": [{ "show": true, "color": { "solid": { "color": "#5A6A80" } }, "fontFamily": "Segoe UI Semibold", "fontSize": 9 }],
        "wordWrap": [{ "show": true }]
      }
    },
    "multiRowCard": {
      "*": {
        "dataLabels": [{ "color": { "solid": { "color": "#101A29" } }, "fontFamily": "Segoe UI Bold", "fontSize": 20 }],
        "categoryLabels": [{ "color": { "solid": { "color": "#5A6A80" } }, "fontSize": 9 }],
        "cardTitle": [{ "color": { "solid": { "color": "#101A29" } }, "fontSize": 11 }]
      }
    },
    "slicer": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } } }],
        "header": [{ "show": true, "fontColor": { "solid": { "color": "#5A6A80" } }, "fontFamily": "Segoe UI Semibold", "fontSize": 9, "background": { "solid": { "color": "#FFFFFF" } }, "outline": "None" }],
        "items": [{ "fontColor": { "solid": { "color": "#101A29" } }, "background": { "solid": { "color": "#F6F8FB" } }, "fontSize": 11 }],
        "selection": [{ "strictSingleSelect": true }]
      }
    },
    "tableEx": {
      "*": {
        "grid": [{ "gridVertical": false, "gridHorizontal": true, "gridHorizontalColor": { "solid": { "color": "#E8EDF4" } }, "gridHorizontalWeight": 1, "rowPadding": 6, "outlineColor": { "solid": { "color": "#DDE3EC" } }, "outlineWeight": 1 }],
        "columnHeaders": [{ "fontColor": { "solid": { "color": "#5A6A80" } }, "backColor": { "solid": { "color": "#F6F8FB" } }, "fontFamily": "Segoe UI Semibold", "fontSize": 9, "alignment": "Left" }],
        "values": [{ "fontColor": { "solid": { "color": "#101A29" } }, "backColor": { "solid": { "color": "#FFFFFF" } }, "backColorSecondary": { "solid": { "color": "#FCFDFE" } }, "fontSize": 10 }],
        "total": [{ "fontColor": { "solid": { "color": "#101A29" } }, "backColor": { "solid": { "color": "#F6F8FB" } }, "fontFamily": "Segoe UI Semibold" }]
      }
    },
    "pivotTable": {
      "*": {
        "grid": [{ "gridVertical": false, "gridHorizontal": true, "gridHorizontalColor": { "solid": { "color": "#E8EDF4" } }, "rowPadding": 6 }],
        "columnHeaders": [{ "fontColor": { "solid": { "color": "#5A6A80" } }, "backColor": { "solid": { "color": "#F6F8FB" } }, "fontFamily": "Segoe UI Semibold", "fontSize": 9 }],
        "values": [{ "fontColor": { "solid": { "color": "#101A29" } }, "fontSize": 10 }]
      }
    },
    "barChart": {
      "*": {
        "categoryAxis": [{ "showAxisTitle": false, "labelColor": { "solid": { "color": "#5A6A80" } }, "fontSize": 10, "gridlineShow": false }],
        "valueAxis": [{ "showAxisTitle": false, "labelColor": { "solid": { "color": "#8996A8" } }, "fontSize": 9, "gridlineShow": true, "gridlineColor": { "solid": { "color": "#E8EDF4" } }, "gridlineThickness": 1 }],
        "labels": [{ "show": true, "color": { "solid": { "color": "#101A29" } }, "fontSize": 10, "fontFamily": "Segoe UI Semibold" }],
        "legend": [{ "show": true, "position": "TopCenter", "showTitle": false, "labelColor": { "solid": { "color": "#5A6A80" } }, "fontSize": 10 }]
      }
    },
    "clusteredBarChart": {
      "*": {
        "categoryAxis": [{ "showAxisTitle": false, "labelColor": { "solid": { "color": "#5A6A80" } }, "fontSize": 10, "gridlineShow": false }],
        "valueAxis": [{ "showAxisTitle": false, "labelColor": { "solid": { "color": "#8996A8" } }, "fontSize": 9, "gridlineColor": { "solid": { "color": "#E8EDF4" } } }],
        "labels": [{ "show": true, "color": { "solid": { "color": "#101A29" } }, "fontSize": 10 }],
        "legend": [{ "show": true, "position": "TopCenter", "showTitle": false, "labelColor": { "solid": { "color": "#5A6A80" } } }]
      }
    },
    "columnChart": {
      "*": {
        "categoryAxis": [{ "showAxisTitle": false, "labelColor": { "solid": { "color": "#5A6A80" } }, "fontSize": 10, "gridlineShow": false }],
        "valueAxis": [{ "showAxisTitle": false, "labelColor": { "solid": { "color": "#8996A8" } }, "fontSize": 9, "gridlineColor": { "solid": { "color": "#E8EDF4" } } }],
        "legend": [{ "show": true, "position": "TopCenter", "showTitle": false, "labelColor": { "solid": { "color": "#5A6A80" } } }]
      }
    },
    "lineChart": {
      "*": {
        "categoryAxis": [{ "showAxisTitle": false, "labelColor": { "solid": { "color": "#5A6A80" } }, "gridlineShow": false }],
        "valueAxis": [{ "showAxisTitle": false, "labelColor": { "solid": { "color": "#8996A8" } }, "gridlineColor": { "solid": { "color": "#E8EDF4" } } }],
        "lineStyles": [{ "strokeWidth": 2, "lineStyle": "solid" }],
        "legend": [{ "show": true, "position": "TopCenter", "showTitle": false, "labelColor": { "solid": { "color": "#5A6A80" } } }]
      }
    },
    "textbox": {
      "*": {
        "background": [{ "show": false }],
        "border": [{ "show": false }],
        "dropShadow": [{ "show": false }]
      }
    },
    "shape": {
      "*": {
        "background": [{ "show": false }],
        "border": [{ "show": false }],
        "dropShadow": [{ "show": false }]
      }
    },
    "actionButton": {
      "*": {
        "fill": [{ "show": true, "fillColor": { "solid": { "color": "#2A78D6" } }, "transparency": 0 }],
        "text": [{ "show": true, "fontColor": { "solid": { "color": "#FFFFFF" } }, "fontFamily": "Segoe UI Semibold", "fontSize": 11 }],
        "border": [{ "show": false }],
        "visualHeader": [{ "show": false }],
        "dropShadow": [{ "show": false }]
      }
    }
  }
}
